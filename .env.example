# Beacon of Blessings - Environment Variables
# Copy this file to .env.local and fill in values

# -- Site ------------------------------------------
NEXT_PUBLIC_SITE_URL=https://beaconofblessings.org

# -- Stripe (Donations) ---------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# -- Email (Resend) --------------------------------
RESEND_API_KEY=re_...
EMAIL_FROM=Beacon of Blessings <noreply@yourdomain.com>
ORG_EMAIL=info@beaconofblessings.org

# -- Analytics (Optional) -------------------------
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# -- Sanity CMS ------------------------------------
# Optional. Without these, the site uses static data from src/data/.
# With SANITY_PROJECT_ID set, the site fetches live content from Sanity CMS.
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
